# Copy to .env.local and fill in at least one key.
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: where the SQLite file lives (default: data/agent.db)
# AGENT_DB_PATH=data/agent.db

# Optional: compaction thresholds (uncompacted message count / messages kept verbatim)
# COMPACT_AFTER=12
# KEEP_RECENT=4
